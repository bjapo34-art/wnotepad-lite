#include "../src/resources.h"
#include <windows.h>

// Manifest para temas visuales
1 RT_MANIFEST "app.manifest"

// Icono (opcional; si no existe, comenta esta línea)
// IDI_APPLICATION ICON "notepad.ico"

// Diálogo "Ir a la línea"
IDD_IR_LINEA DIALOGEX 0, 0, 180, 60
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Ir a la línea"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "Línea:", -1, 7, 10, 30, 8
    EDITTEXT        1001, 40, 8, 60, 12, ES_AUTOHSCROLL | ES_NUMBER
    DEFPUSHBUTTON   "Aceptar", IDOK, 110, 7, 50, 14
    PUSHBUTTON      "Cancelar", IDCANCEL, 110, 25, 50, 14
END

// Diálogo "Fuente"
IDD_FUENTE DIALOGEX 0, 0, 300, 230
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Fuente"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    LTEXT           "Fuente:", -1, 7, 8, 40, 8
    LISTBOX         IDC_FUENTE_FAMILIA, 7, 19, 140, 120, LBS_OWNERDRAWVARIABLE | LBS_HASSTRINGS | LBS_NOINTEGRALHEIGHT | WS_BORDER | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Tamaño:", -1, 158, 8, 40, 8
    COMBOBOX        IDC_FUENTE_TAMANO, 158, 19, 50, 90, CBS_DROPDOWN | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Estilo:", -1, 218, 8, 40, 8
    COMBOBOX        IDC_FUENTE_ESTILO, 218, 19, 60, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Muestra:", -1, 7, 148, 40, 8
    CONTROL         "AaBbCcYyZz 123", IDC_FUENTE_MUESTRA, "Static", SS_CENTER | SS_CENTERIMAGE | WS_BORDER, 7, 158, 271, 26
    DEFPUSHBUTTON   "Aceptar", IDOK, 172, 196, 50, 14
    PUSHBUTTON      "Cancelar", IDCANCEL, 228, 196, 50, 14
END