#include "../src/resources.h"
#include <windows.h>

// Manifest para temas visuales
1 RT_MANIFEST "app.manifest"

// Icono (opcional; si no existe, comenta esta línea)
// IDI_APPLICATION ICON "notepad.ico"

// Diálogo "Ir a la línea"
IDD_IR_LINEA DIALOGEX 0, 0, 180, 60
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Ir a la línea"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "Línea:", -1, 7, 10, 30, 8
    EDITTEXT        1001, 40, 8, 60, 12, ES_AUTOHSCROLL | ES_NUMBER
    DEFPUSHBUTTON   "Aceptar", IDOK, 110, 7, 50, 14
    PUSHBUTTON      "Cancelar", IDCANCEL, 110, 25, 50, 14
END